/* Lucky Number HUD. Reference resolution 1920x1080. Display font (Cinzel) only on .title-font. */

.root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: rgb(255, 243, 214);
    font-size: 28px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(20, 8, 10);
}

.hud {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    transition-property: opacity, translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-cubic;
}

.hud.hidden {
    opacity: 0;
    translate: 0 -30px;
}

/* ---------- Side panels ---------- */

.side-panel {
    position: absolute;
    top: 22px;
    flex-direction: row;
    align-items: center;
}

.hero-panel { left: 30px; }
.boss-panel { right: 30px; flex-direction: row-reverse; }

.portrait {
    width: 124px;
    height: 124px;
    border-radius: 62px;
    border-width: 5px;
    border-color: rgb(255, 205, 110);
    background-color: rgb(28, 14, 18);
    -unity-background-scale-mode: scale-and-crop;
}

.side-info {
    margin-left: 14px;
    align-items: flex-start;
}

.side-info.right {
    margin-left: 0;
    margin-right: 14px;
    align-items: flex-end;
}

.name {
    font-size: 36px;
    color: rgb(255, 220, 140);
    -unity-text-outline-width: 2px;
    text-shadow: 0 4px 0 rgba(0, 0, 0, 0.7);
    margin-bottom: -2px;
}

.subtitle {
    font-size: 26px;
    color: rgb(214, 196, 160);
    margin-bottom: 2px;
}

/* ---------- HP bars: gold frame behind, fill inside the track ---------- */

.bar {
    width: 460px;
    height: 64px;
    background-image: url("project://database/Assets/Art/UI/bar_frame.png");
    -unity-slice-left: 160;
    -unity-slice-right: 160;
    -unity-slice-top: 55;
    -unity-slice-bottom: 55;
    -unity-slice-scale: 0.38px;
}

.bar-fill, .bar-ghost, .bar-shine {
    position: absolute;
    left: 56px;
    top: 17px;
    bottom: 18px;
    width: 0;
    border-radius: 6px;
}

.bar-ghost { background-color: rgb(255, 244, 196); }
.hero-fill { background-color: rgb(70, 214, 110); }
.boss-fill { background-color: rgb(226, 44, 70); }
.bar-fill.flash { background-color: rgb(255, 255, 255); }

.bar-shine {
    width: 348px;
    bottom: 34px;
    background-color: rgba(255, 255, 255, 0.18);
}

.bar-label {
    position: absolute;
    left: 0; right: 0; top: 4px; bottom: 6px;
    -unity-text-align: middle-center;
    font-size: 32px;
    -unity-text-outline-width: 3px;
}

/* ---------- Center: depth pips and gold ---------- */

.center-panel {
    position: absolute;
    top: 16px;
    left: 0; right: 0;
    align-items: center;
}

.pips { flex-direction: row; }

.pip {
    width: 50px;
    height: 50px;
    margin: 0 5px;
    border-radius: 25px;
    border-width: 3px;
    border-color: rgb(110, 90, 70);
    background-color: rgb(25, 18, 20);
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0.55;
    transition-property: scale, opacity, border-color;
    transition-duration: 0.25s;
}

.pip.current {
    opacity: 1;
    border-color: rgb(255, 205, 110);
    scale: 1.25 1.25;
}

.pip.defeated {
    opacity: 1;
    border-color: rgb(120, 230, 140);
    -unity-background-image-tint-color: rgb(110, 110, 110);
}

.depth-label {
    font-size: 28px;
    color: rgb(230, 210, 170);
    margin-top: 6px;
    letter-spacing: 2px;
}

.gold-box {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    padding: 2px 18px 2px 8px;
    border-radius: 30px;
    background-color: rgba(10, 6, 8, 0.62);
    border-width: 2px;
    border-color: rgba(255, 205, 110, 0.6);
}

.gold-icon {
    width: 50px;
    height: 50px;
    background-image: url("project://database/Assets/Art/VFX/vfx_coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

.gold-label {
    font-size: 44px;
    color: rgb(255, 214, 92);
    margin-left: 8px;
    -unity-text-outline-width: 3px;
}

/* ---------- Need pill above the wheel ---------- */

.need-pill {
    position: absolute;
    top: 470px;
    left: 50%;
    translate: -50% 0;
    width: 400px;
    height: 92px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-radius: 46px;
    background-color: rgba(12, 8, 12, 0.78);
    border-width: 3px;
    border-color: rgba(200, 180, 150, 0.6);
    transition-property: border-color, background-color;
    transition-duration: 0.3s;
}

.need-pill.lucky {
    background-color: rgba(70, 40, 6, 0.9);
    border-color: rgb(255, 214, 92);
}

.need-icon {
    width: 58px;
    height: 46px;
    margin-right: 8px;
    background-image: url("project://database/Assets/Art/UI/icon_crown.png");
    -unity-background-scale-mode: scale-to-fit;
    display: none;
}

.need-pill.lucky .need-icon { display: flex; }

.need-caption {
    font-size: 30px;
    color: rgb(214, 196, 160);
    margin-right: 12px;
    letter-spacing: 1px;
}

.need-pill.lucky .need-caption { color: rgb(255, 225, 150); }

.need-value {
    font-size: 64px;
    color: rgb(255, 243, 214);
    -unity-text-outline-width: 3px;
}

.need-pill.lucky .need-value { color: rgb(255, 214, 92); }

/* ---------- Spin button ---------- */

.spin-button {
    position: absolute;
    right: 50px;
    bottom: 52px;
    width: 250px;
    height: 250px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 125px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/spin_button.png");
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.09s;
    transition-timing-function: ease-out-back;
}

.spin-button:hover { scale: 1.06 1.06; }
.spin-button:active { scale: 0.9 0.9; }
.spin-button.locked { -unity-background-image-tint-color: rgb(120, 110, 115); scale: 0.92 0.92; }
.spin-button.locked .spin-label { color: rgb(170, 160, 150); }

.spin-label {
    font-size: 72px;
    color: rgb(255, 238, 190);
    -unity-text-outline-width: 4px;
    text-shadow: 0 5px 0 rgba(60, 0, 10, 0.8);
    letter-spacing: 2px;
}

.spin-hint {
    position: absolute;
    right: 50px;
    bottom: 16px;
    width: 250px;
    -unity-text-align: middle-center;
    font-size: 24px;
    color: rgb(200, 185, 160);
}

/* ---------- Pill buttons ---------- */

.pill-button {
    height: 60px;
    min-width: 150px;
    padding: 0 24px;
    margin: 0;
    border-radius: 30px;
    border-width: 3px;
    border-color: rgb(190, 150, 90);
    background-color: rgb(30, 18, 22);
    color: rgb(240, 225, 195);
    font-size: 28px;
    -unity-text-outline-width: 2px;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.09s;
}

.pill-button:hover { scale: 1.05 1.05; border-color: rgb(255, 214, 120); }
.pill-button:active { scale: 0.94 0.94; }
.pill-button.on { background-color: rgb(130, 82, 18); border-color: rgb(255, 214, 92); color: rgb(255, 240, 200); }

.auto-button { position: absolute; right: 320px; bottom: 82px; }
.settings-button { position: absolute; left: 30px; bottom: 30px; }

.big-button {
    height: 96px;
    min-width: 340px;
    padding: 0 48px;
    margin: 12px;
    border-radius: 48px;
    border-width: 4px;
    border-color: rgb(255, 214, 120);
    background-color: rgb(168, 26, 46);
    color: rgb(255, 240, 200);
    font-size: 48px;
    -unity-text-outline-width: 3px;
    text-shadow: 0 4px 0 rgba(60, 0, 10, 0.8);
    transition-property: scale, background-color;
    transition-duration: 0.09s;
    transition-timing-function: ease-out-back;
}

.big-button:hover { scale: 1.06 1.06; background-color: rgb(196, 36, 58); }
.big-button:active { scale: 0.93 0.93; }
.big-button.small { height: 76px; font-size: 36px; min-width: 260px; margin-top: 24px; }

/* ---------- Banner ---------- */

.banner {
    position: absolute;
    left: 0; right: 0;
    top: 230px;
    align-items: center;
    opacity: 0;
}

.banner-title {
    font-size: 150px;
    color: rgb(255, 214, 92);
    -unity-text-outline-width: 6px;
    -unity-text-outline-color: rgb(30, 8, 6);
    text-shadow: 0 10px 0 rgba(80, 10, 0, 0.85);
    -unity-text-align: middle-center;
}

.banner-sub {
    font-size: 44px;
    color: rgb(255, 240, 210);
    -unity-text-outline-width: 3px;
    -unity-text-align: middle-center;
    margin-top: -6px;
}

/* ---------- Overlays ---------- */

.flash, .fade {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    opacity: 0;
}

.flash { background-color: rgb(255, 255, 255); }
.fade { background-color: rgb(6, 3, 6); }

/* ---------- Screens ---------- */

.screen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 3, 8, 0.72);
    display: none;
}

.title-screen { background-color: rgba(6, 3, 8, 0.45); }

.title-logo {
    width: 1080px;
    height: 364px;
    background-image: url("project://database/Assets/Art/UI/logo.png");
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 4px;
}

.tagline {
    font-size: 34px;
    color: rgb(240, 225, 195);
    margin-bottom: 26px;
}

.stats-line {
    font-size: 30px;
    color: rgb(255, 214, 92);
    margin-top: 18px;
}

.credits {
    position: absolute;
    bottom: 24px;
    font-size: 24px;
    color: rgb(170, 155, 135);
}

.panel {
    min-width: 820px;
    padding: 56px 72px 48px 72px;
    align-items: center;
    background-image: url("project://database/Assets/Art/UI/panel_frame.png");
    -unity-slice-left: 120;
    -unity-slice-right: 120;
    -unity-slice-top: 120;
    -unity-slice-bottom: 120;
    -unity-slice-scale: 0.6px;
}

.panel-title {
    font-size: 76px;
    color: rgb(255, 214, 92);
    -unity-text-outline-width: 4px;
    text-shadow: 0 6px 0 rgba(80, 10, 0, 0.85);
    -unity-text-align: middle-center;
}

.panel-sub {
    font-size: 34px;
    color: rgb(240, 225, 195);
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.stats { align-items: stretch; margin-bottom: 18px; min-width: 560px; }

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 4px;
    border-bottom-width: 2px;
    border-color: rgba(255, 205, 110, 0.18);
}

.stat-name { font-size: 32px; color: rgb(214, 196, 160); }
.stat-value { font-size: 36px; color: rgb(255, 243, 214); }
.stat-value.gold { color: rgb(255, 214, 92); }

.button-row { flex-direction: row; align-items: center; }

.settings-panel { min-width: 760px; }

.setting-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 600px;
    margin: 10px 0;
}

.setting-name { font-size: 32px; flex-grow: 1; }
.setting-value { font-size: 32px; width: 110px; -unity-text-align: middle-center; }

.step-button {
    width: 64px;
    height: 64px;
    margin: 0;
    padding: 0;
    border-radius: 32px;
    border-width: 3px;
    border-color: rgb(190, 150, 90);
    background-color: rgb(30, 18, 22);
    color: rgb(255, 230, 180);
    font-size: 40px;
    -unity-text-align: middle-center;
    transition-property: scale;
    transition-duration: 0.09s;
}

.step-button:hover { scale: 1.08 1.08; }
.step-button:active { scale: 0.9 0.9; }
.toggle-button { min-width: 130px; }

/* ---------- Charm badge under the hero panel ---------- */

.charm-badge {
    position: absolute;
    left: 168px;
    top: 152px;
    flex-direction: row;
    align-items: center;
    padding: 2px 16px 2px 6px;
    border-radius: 30px;
    background-color: rgba(10, 18, 8, 0.7);
    border-width: 2px;
    border-color: rgba(150, 255, 110, 0.65);
    display: none;
}

.charm-badge.on { display: flex; }

.charm-icon {
    width: 52px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
}

.charm-label {
    font-size: 34px;
    color: rgb(170, 255, 130);
    margin-left: 6px;
    -unity-text-outline-width: 3px;
}

/* ---------- Firebomb button (left of AUTO / SPIN) ---------- */

.bomb-button {
    position: absolute;
    right: 335px;
    bottom: 168px;
    width: 128px;
    height: 128px;
    margin: 0;
    padding: 0;
    border-radius: 64px;
    border-width: 4px;
    border-color: rgb(255, 160, 70);
    background-color: rgb(40, 16, 10);
    align-items: center;
    justify-content: center;
    transition-property: scale, opacity, border-color;
    transition-duration: 0.09s;
    transition-timing-function: ease-out-back;
}

.bomb-button:hover { scale: 1.08 1.08; border-color: rgb(255, 214, 120); }
.bomb-button:active { scale: 0.9 0.9; }
.bomb-button.locked { opacity: 0.45; scale: 0.92 0.92; }
.bomb-button.empty { display: none; }

.bomb-icon {
    width: 96px;
    height: 96px;
    background-image: url("project://database/Assets/Art/UI/icon_firebomb.png");
    -unity-background-scale-mode: scale-to-fit;
}

.bomb-count {
    position: absolute;
    right: -10px;
    bottom: -8px;
    font-size: 34px;
    color: rgb(255, 214, 120);
    padding: 0 10px;
    border-radius: 22px;
    background-color: rgb(120, 30, 20);
    -unity-text-outline-width: 3px;
}

.bomb-hint {
    position: absolute;
    right: 335px;
    bottom: 128px;
    width: 128px;
    -unity-text-align: middle-center;
    font-size: 24px;
    color: rgb(200, 185, 160);
}

.bomb-hint.empty { display: none; }

/* ---------- Shop ---------- */

.shop-button { background-color: rgb(120, 82, 18); }
.shop-button:hover { background-color: rgb(150, 104, 26); }

.shop-panel { width: 1580px; padding: 44px 60px 36px 60px; }

.shop-gold { margin: 6px 0 18px 0; }

.shop-items {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 16px;
}

.shop-card {
    width: 330px;
    height: 520px;
    margin: 0 12px;
    padding: 20px 18px;
    align-items: center;
    border-radius: 26px;
    border-width: 3px;
    border-color: rgba(255, 205, 110, 0.55);
    background-color: rgba(18, 10, 14, 0.82);
    transition-property: border-color, opacity;
    transition-duration: 0.2s;
}

.shop-card:hover { border-color: rgb(255, 214, 120); }

.card-icon {
    width: 136px;
    height: 136px;
    -unity-background-scale-mode: scale-to-fit;
}

.card-name {
    font-size: 38px;
    color: rgb(255, 214, 92);
    margin-top: 6px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
}

.card-level {
    font-size: 28px;
    color: rgb(170, 255, 130);
    margin-bottom: 6px;
}

.card-desc {
    flex-grow: 1;
    font-size: 28px;
    color: rgb(240, 225, 195);
    white-space: normal;
    -unity-text-align: upper-center;
}

.card-buy {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 72px;
    min-width: 220px;
    margin: 0;
    padding: 0 22px;
    border-radius: 36px;
    border-width: 3px;
    border-color: rgb(255, 214, 120);
    background-color: rgb(168, 26, 46);
    transition-property: scale, background-color;
    transition-duration: 0.09s;
    transition-timing-function: ease-out-back;
}

.card-buy:hover { scale: 1.06 1.06; background-color: rgb(196, 36, 58); }
.card-buy:active { scale: 0.93 0.93; }

.card-coin {
    width: 42px;
    height: 42px;
    margin-right: 8px;
    background-image: url("project://database/Assets/Art/VFX/vfx_coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

.card-price {
    font-size: 38px;
    color: rgb(255, 240, 200);
    -unity-text-outline-width: 3px;
}

.shop-card.poor .card-price { color: rgb(255, 130, 130); }
.shop-card.poor .card-buy { background-color: rgb(70, 30, 36); }
.shop-card.done .card-buy, .shop-card.locked .card-buy { background-color: rgb(40, 34, 30); border-color: rgb(120, 100, 80); }
.shop-card.done .card-coin, .shop-card.locked .card-coin { display: none; }
.shop-card.done .card-price, .shop-card.locked .card-price { font-size: 30px; color: rgb(200, 185, 160); }
.shop-card.locked { opacity: 0.6; }
.shop-card.locked .card-icon { -unity-background-image-tint-color: rgb(90, 90, 90); }
