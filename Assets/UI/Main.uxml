<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Main.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">

        <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
            <ui:VisualElement name="hero-panel" class="side-panel hero-panel" picking-mode="Ignore">
                <ui:VisualElement name="hero-portrait" class="portrait" picking-mode="Ignore" />
                <ui:VisualElement class="side-info" picking-mode="Ignore">
                    <ui:Label name="hero-name" text="ACE" class="name title-font" picking-mode="Ignore" />
                    <ui:VisualElement name="hero-bar" class="bar" picking-mode="Ignore">
                        <ui:VisualElement name="hero-ghost" class="bar-ghost" picking-mode="Ignore" />
                        <ui:VisualElement name="hero-fill" class="bar-fill hero-fill" picking-mode="Ignore" />
                        <ui:VisualElement class="bar-shine" picking-mode="Ignore" />
                        <ui:Label name="hero-hp" text="100 / 100" class="bar-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="hero-status" class="traits" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="charm-badge" class="charm-badge" picking-mode="Ignore">
                <ui:VisualElement name="charm-icon" class="charm-icon" picking-mode="Ignore" />
                <ui:Label name="charm-label" text="+1" class="charm-label" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="center-panel" class="center-panel" picking-mode="Ignore">
                <ui:VisualElement name="depth-pips" class="pips" picking-mode="Ignore" />
                <ui:Label name="depth-label" text="DEPTH 1 / 5" class="depth-label" picking-mode="Ignore" />
                <ui:VisualElement name="gold-box" class="gold-box" picking-mode="Ignore">
                    <ui:VisualElement name="gold-icon" class="gold-icon" picking-mode="Ignore" />
                    <ui:Label name="gold-label" text="0" class="gold-label" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="boss-panel" class="side-panel boss-panel" picking-mode="Ignore">
                <ui:VisualElement name="boss-portrait" class="portrait" picking-mode="Ignore" />
                <ui:VisualElement class="side-info right" picking-mode="Ignore">
                    <ui:Label name="boss-name" text="BOSS" class="name title-font" picking-mode="Ignore" />
                    <ui:Label name="boss-title" text="Title" class="subtitle" picking-mode="Ignore" />
                    <ui:VisualElement name="boss-bar" class="bar" picking-mode="Ignore">
                        <ui:VisualElement name="boss-ghost" class="bar-ghost" picking-mode="Ignore" />
                        <ui:VisualElement name="boss-fill" class="bar-fill boss-fill" picking-mode="Ignore" />
                        <ui:VisualElement class="bar-shine" picking-mode="Ignore" />
                        <ui:Label name="boss-hp" text="10 / 10" class="bar-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="boss-traits" class="traits right" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="need-pill" class="need-pill" picking-mode="Ignore">
                <ui:VisualElement name="need-icon" class="need-icon" picking-mode="Ignore" />
                <ui:Label text="LUCKY NUMBER" class="need-caption" picking-mode="Ignore" />
                <ui:Label name="need-value" text="10" class="need-value" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="active-card" class="active-card" picking-mode="Ignore">
                <ui:VisualElement name="active-card-art" class="active-card-art" picking-mode="Ignore" />
                <ui:VisualElement class="active-card-text" picking-mode="Ignore">
                    <ui:Label name="active-card-name" text="" class="active-card-name title-font" picking-mode="Ignore" />
                    <ui:Label name="active-card-up" text="" class="tarot-up" picking-mode="Ignore" />
                    <ui:Label name="active-card-down" text="" class="tarot-down" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Button name="spin-button" class="spin-button">
                <ui:Label name="spin-label" text="SPIN" class="spin-label" picking-mode="Ignore" />
            </ui:Button>
            <ui:Label name="spin-hint" text="or press SPACE" class="spin-hint" picking-mode="Ignore" />
            <ui:VisualElement name="item-bar" class="item-bar" picking-mode="Ignore" />
            <ui:Button name="auto-button" text="AUTO" class="pill-button auto-button" />
            <ui:Button name="settings-button" class="pill-button settings-button">
                <ui:Label text="PAUSE" picking-mode="Ignore" />
                <ui:Label text="ESC" class="keycap" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>

        <ui:VisualElement name="tarot-picker" class="tarot-picker" picking-mode="Ignore">
            <ui:Label name="tarot-caption" text="MADAME FORTUNA DEALS  ·  PICK ONE" class="tarot-caption title-font" picking-mode="Ignore" />
            <ui:VisualElement name="tarot-row" class="tarot-row" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="banner" class="banner" picking-mode="Ignore">
            <ui:Label name="banner-title" text="" class="banner-title" picking-mode="Ignore" />
            <ui:Label name="banner-sub" text="" class="banner-sub" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="flash" class="flash" picking-mode="Ignore" />
        <ui:VisualElement name="fade" class="fade" picking-mode="Ignore" />

        <ui:VisualElement name="title-screen" class="screen title-screen">
            <ui:VisualElement name="title-logo" class="title-logo" picking-mode="Ignore" />
            <ui:Label name="title-tagline" text="Hit the exact number. Break the curse." class="tagline" picking-mode="Ignore" />
            <ui:VisualElement name="title-buttons" class="button-column" picking-mode="Ignore">
                <ui:VisualElement class="primary-wrap" picking-mode="Ignore">
                    <ui:VisualElement name="title-play-glow" class="primary-glow" picking-mode="Ignore" />
                    <ui:Button name="title-play" text="PLAY" class="big-button primary">
                        <ui:VisualElement class="btn-shine" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:Button name="title-shop" text="SHOP" class="secondary-button">
                    <ui:Label name="title-shop-badge" text="" class="badge" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="title-stats" class="title-stats" picking-mode="Ignore">
                <ui:VisualElement class="title-stat" picking-mode="Ignore">
                    <ui:VisualElement class="title-stat-icon icon-coin" picking-mode="Ignore" />
                    <ui:Label name="title-gold" text="0" class="title-stat-label gold" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="title-stat" picking-mode="Ignore">
                    <ui:VisualElement class="title-stat-icon icon-skull" picking-mode="Ignore" />
                    <ui:Label name="title-depth" text="" class="title-stat-label" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="title-wins-stat" class="title-stat" picking-mode="Ignore">
                    <ui:VisualElement class="title-stat-icon icon-crown" picking-mode="Ignore" />
                    <ui:Label name="title-wins" text="" class="title-stat-label" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="Team Lucky Number  ·  Unity Game Jam 2026" class="credits" picking-mode="Ignore" />
            <ui:Button name="title-reset" text="Reset progress" class="text-button title-reset" />
        </ui:VisualElement>

        <ui:VisualElement name="end-screen" class="screen end-screen">
            <ui:VisualElement name="end-panel" class="panel">
                <ui:Label name="end-title" text="" class="panel-title title-font" picking-mode="Ignore" />
                <ui:Label name="end-sub" text="" class="panel-sub" picking-mode="Ignore" />
                <ui:Label name="end-ribbon" text="" class="ribbon" picking-mode="Ignore" />
                <ui:VisualElement name="end-stats" class="stats" picking-mode="Ignore" />
                <ui:Label name="end-note" text="" class="end-note" picking-mode="Ignore" />
                <ui:VisualElement name="end-buttons" class="end-buttons" picking-mode="Ignore">
                    <ui:VisualElement class="button-row" picking-mode="Ignore">
                        <ui:Button name="end-retry" text="PLAY AGAIN" class="big-button primary">
                            <ui:VisualElement class="btn-shine" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="end-shop" text="SHOP" class="secondary-button">
                            <ui:Label name="end-shop-badge" text="" class="badge" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:Button name="end-menu" text="Main menu" class="text-button" />
                </ui:VisualElement>
                <ui:VisualElement name="end-fx" class="fx-layer" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="shop-screen" class="screen shop-screen">
            <ui:VisualElement class="tree-backdrop" picking-mode="Ignore" />
            <ui:VisualElement name="tree-viewport" class="tree-viewport" />
            <ui:VisualElement class="tree-vignette" picking-mode="Ignore" />
            <ui:VisualElement class="shop-header" picking-mode="Ignore">
                <ui:Label text="THE PATHS OF FATE" class="shop-title title-font" picking-mode="Ignore" />
                <ui:VisualElement class="shop-top" picking-mode="Ignore">
                    <ui:VisualElement name="shop-gold" class="gold-box shop-gold" picking-mode="Ignore">
                        <ui:VisualElement class="gold-icon" picking-mode="Ignore" />
                        <ui:Label name="shop-gold-label" text="0" class="gold-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="shop-stats" class="shop-stats" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="shop-detail" class="shop-detail" picking-mode="Ignore">
                <ui:VisualElement name="shop-detail-icon" class="shop-detail-icon" picking-mode="Ignore" />
                <ui:VisualElement class="shop-detail-body" picking-mode="Ignore">
                    <ui:Label name="shop-detail-name" text="" class="shop-detail-name" picking-mode="Ignore" />
                    <ui:Label name="shop-detail-level" text="" class="shop-detail-level" picking-mode="Ignore" />
                    <ui:Label name="shop-detail-desc" text="" class="shop-detail-desc" picking-mode="Ignore" />
                    <ui:VisualElement class="shop-detail-price" picking-mode="Ignore">
                        <ui:VisualElement name="shop-detail-coin" class="card-coin" picking-mode="Ignore" />
                        <ui:Label name="shop-detail-cost" text="" class="shop-detail-cost" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="Click to buy  ·  Drag to pan  ·  Scroll to zoom" class="tree-hint" picking-mode="Ignore" />
            <ui:VisualElement class="shop-actions">
                <ui:Button name="shop-back" text="BACK" class="secondary-button" />
                <ui:Button name="shop-begin" text="PLAY" class="big-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="settings-screen" class="screen settings-screen">
            <ui:VisualElement name="settings-panel" class="panel settings-panel">
                <ui:Label text="PAUSED" class="panel-title settings-title title-font" picking-mode="Ignore" />
                <ui:VisualElement class="setting-row">
                    <ui:Label text="Music" class="setting-name" picking-mode="Ignore" />
                    <ui:Button name="music-down" text="−" class="step-button" />
                    <ui:VisualElement name="music-pips" class="volume-pips" />
                    <ui:Button name="music-up" text="+" class="step-button" />
                </ui:VisualElement>
                <ui:VisualElement class="setting-row">
                    <ui:Label text="Sound effects" class="setting-name" picking-mode="Ignore" />
                    <ui:Button name="sfx-down" text="−" class="step-button" />
                    <ui:VisualElement name="sfx-pips" class="volume-pips" />
                    <ui:Button name="sfx-up" text="+" class="step-button" />
                </ui:VisualElement>
                <ui:VisualElement class="setting-row">
                    <ui:Label text="Screen shake" class="setting-name" picking-mode="Ignore" />
                    <ui:Button name="shake-toggle" class="switch">
                        <ui:VisualElement class="switch-knob" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="setting-row">
                    <ui:Label text="Screen flashes" class="setting-name" picking-mode="Ignore" />
                    <ui:Button name="flash-toggle" class="switch">
                        <ui:VisualElement class="switch-knob" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:Button name="settings-close" text="RESUME" class="big-button settings-close" />
                <ui:Button name="settings-quit" text="Quit to menu" class="text-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="reset-screen" class="screen">
            <ui:VisualElement name="reset-panel" class="panel">
                <ui:Label text="RESET PROGRESS?" class="panel-title settings-title title-font" picking-mode="Ignore" />
                <ui:Label text="All gold, upgrades, best depth and wins will be lost.&#10;Your settings are kept. This cannot be undone." class="panel-sub" picking-mode="Ignore" />
                <ui:VisualElement class="button-row" picking-mode="Ignore">
                    <ui:Button name="reset-cancel" text="CANCEL" class="secondary-button" />
                    <ui:Button name="reset-confirm" text="RESET" class="big-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="loading-screen" class="loading-screen">
            <ui:VisualElement name="loading-glow" class="loading-glow" picking-mode="Ignore" />
            <ui:VisualElement class="loading-vignette" picking-mode="Ignore" />
            <ui:VisualElement name="loading-logo" class="loading-logo" picking-mode="Ignore" />
            <ui:VisualElement class="loading-wheel" picking-mode="Ignore">
                <ui:VisualElement name="loading-ring" class="loading-ring" picking-mode="Ignore" />
                <ui:VisualElement name="loading-hub" class="loading-hub" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="loading-bar" picking-mode="Ignore">
                <ui:VisualElement name="loading-fill" class="loading-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="loading-label" text="Shuffling the cards of fate" class="loading-label" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
